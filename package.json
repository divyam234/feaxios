{
  "name": "feaxios",
  "version": "0.0.22",
  "description": "Tiny Fetch wrapper that provides a similar API to Axios",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "bun@1.3.11",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./retry": {
      "import": {
        "types": "./dist/plugins/retry.d.ts",
        "default": "./dist/plugins/retry.mjs"
      },
      "require": {
        "types": "./dist/plugins/retry.d.ts",
        "default": "./dist/plugins/retry.js"
      }
    },
    "./logger": {
      "import": {
        "types": "./dist/plugins/logger.d.ts",
        "default": "./dist/plugins/logger.mjs"
      },
      "require": {
        "types": "./dist/plugins/logger.d.ts",
        "default": "./dist/plugins/logger.js"
      }
    },
    "./cookie-jar": {
      "import": {
        "types": "./dist/plugins/cookie-jar.d.ts",
        "default": "./dist/plugins/cookie-jar.mjs"
      },
      "require": {
        "types": "./dist/plugins/cookie-jar.d.ts",
        "default": "./dist/plugins/cookie-jar.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.mjs"
      },
      "require": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./plugins/retry": {
      "import": {
        "types": "./dist/plugins/retry.d.ts",
        "default": "./dist/plugins/retry.mjs"
      },
      "require": {
        "types": "./dist/plugins/retry.d.ts",
        "default": "./dist/plugins/retry.js"
      }
    },
    "./plugins/logger": {
      "import": {
        "types": "./dist/plugins/logger.d.ts",
        "default": "./dist/plugins/logger.mjs"
      },
      "require": {
        "types": "./dist/plugins/logger.d.ts",
        "default": "./dist/plugins/logger.js"
      }
    },
    "./plugins/cookie-jar": {
      "import": {
        "types": "./dist/plugins/cookie-jar.d.ts",
        "default": "./dist/plugins/cookie-jar.mjs"
      },
      "require": {
        "types": "./dist/plugins/cookie-jar.d.ts",
        "default": "./dist/plugins/cookie-jar.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "retry": [
        "./dist/plugins/retry.d.ts"
      ],
      "logger": [
        "./dist/plugins/logger.d.ts"
      ],
      "cookie-jar": [
        "./dist/plugins/cookie-jar.d.ts"
      ],
      "plugins": [
        "./dist/plugins/index.d.ts"
      ],
      "plugins/retry": [
        "./dist/plugins/retry.d.ts"
      ],
      "plugins/logger": [
        "./dist/plugins/logger.d.ts"
      ],
      "plugins/cookie-jar": [
        "./dist/plugins/cookie-jar.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "publish": "bun publish --access public",
    "format": "prettier --write './**/*.{ts,md}'",
    "format:check": "prettier --check './**/*.{ts,md}'"
  },
  "files": [
    "dist"
  ],
  "eslintConfig": {
    "extends": [
      "prettier"
    ]
  },
  "repository": "divyam234/feaxios",
  "keywords": [
    "axios",
    "fetch"
  ],
  "license": "MIT",
  "homepage": "https://github.com/divyam234/feaxios",
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "msw": "^2.12.14",
    "prettier": "^3.8.1",
    "terser": "^5.46.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "is-retry-allowed": "^3.0.0",
    "tough-cookie": "^6.0.1"
  }
}
